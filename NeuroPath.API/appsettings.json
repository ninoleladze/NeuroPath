{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\ProjectModels;Database=NeuroPathDb;Trusted_Connection=true;TrustServerCertificate=true;"
  },
  "JwtSettings": {
    "SecretKey": "",
    "Issuer": "NeuroPath",
    "Audience": "NeuroPathClient",
    "AccessTokenExpirationMinutes": 30,
    "RefreshTokenExpirationDays": 7
  },
  "Seed": {
    "AdminEmail": "admin@neuropath.com",
    "AdminPassword": "",
    "ApplyMigrations": false
  },
  "ClientApp": {
    "BaseUrl": "http://localhost:4200",
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "SmtpSettings": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "",
    "Password": "",
    "FromEmail": "noreply@neuropath.com",
    "FromName": "NeuroPath",
    "EnableSsl": true
  },
  "FileUploadSettings": {
    "UploadPath": "wwwroot/uploads",
    "PublicBasePath": "/uploads",
    "MaxFileSizeBytes": 5242880,
    "MaxAvatarSizeBytes": 2097152,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".gif", ".webp", ".pdf" ],
    "AvatarFolder": "avatars",
    "ExerciseImageFolder": "exercises",
    "ArticleImageFolder": "articles",
    "CertificateFolder": "certificates"
  },
  "RateLimitSettings": {
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "QueueLimit": 2,
    "AuthEndpointPermitLimit": 10,
    "AuthEndpointWindowSeconds": 300,
    "FileUploadPermitLimit": 20,
    "FileUploadWindowSeconds": 300
  },
  "BackgroundJobs": {
    "Enabled": true,
    "IntervalMinutes": 60,
    "SnapshotIntervalDays": 7,
    "ActiveUserWindowDays": 30,
    "SnapshotBatchSize": 200,
    "RevokedTokenRetentionDays": 30
  },
  "CacheSettings": {
    "DefaultExpirationMinutes": 10,
    "BrainAreasCacheMinutes": 60,
    "ExerciseCategoriesCacheMinutes": 60,
    "DifficultyLevelsCacheMinutes": 120,
    "TagsCacheMinutes": 60,
    "FaqCacheMinutes": 30,
    "LeaderboardCacheMinutes": 5,
    "DailyTipCacheMinutes": 1440
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
